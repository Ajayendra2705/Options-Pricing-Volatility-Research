# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Raw data IS tracked (60 KB total) so a clean clone reproduces end-to-end and
# CI runs the real-data tests. Immutability is still enforced by the SHA256
# manifest, which the pipeline and CI verify.
!data/raw/*.parquet
!data/raw/manifest.json
data/raw/*.csv
data/raw/*.gz

# Processed data is generated — never tracked
data/processed/*
!data/processed/.gitkeep

# Results — ignore generated artifacts except explicit deliverables
results/*
!results/data_quality.json
!results/report.html

# Plots: regenerable, so ignored — except the three the README embeds
!results/plots/
results/plots/*
!results/plots/gross_vs_net.png
!results/plots/surface_3d_2023-06-14.png
!results/plots/attribution_residuals.png

# Jupyter
.ipynb_checkpoints/

# Agents
.agents/
