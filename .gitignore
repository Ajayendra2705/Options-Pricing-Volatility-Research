# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Raw data IS tracked (60 KB total) so a clean clone reproduces end-to-end and
# CI runs the real-data tests. Immutability is still enforced by the SHA256
# manifest, which the pipeline and CI verify.
!data/raw/*.parquet
!data/raw/manifest.json
data/raw/*.csv
data/raw/*.gz

# Processed data is generated — never tracked
data/processed/*
!data/processed/.gitkeep
data/phase2/processed/*
!data/phase2/processed/.gitkeep

# Results — ignore generated artifacts except explicit deliverables
results/*
!results/data_quality.json
!results/report.html

# Phase-2 (SPY) gate deliverables — tracked like their v1 counterparts
!results/phase2/
results/phase2/*
!results/phase2/data_quality_spy.json
!results/phase2/surface_qc_spy.json
!results/phase2/arb_violations_spy.json
!results/phase2/svi_butterfly_log_spy.json
!results/phase2/har_stats_spy.json
!results/phase2/signal_summary_spy.json
!results/phase2/attribution_reconcile_spy.json
!results/phase2/attribution_gate_spy.json
!results/phase2/portfolio_summary_spy.json
!results/phase2/costs_summary_spy.json
!results/phase2/returns_summary_spy.json
!results/phase2/metrics_spy.json
!results/phase2/walkforward_spy.json
!results/phase2/regime_split_spy.json
!results/phase2/cost_sweep_spy.json

# Plots: regenerable, so ignored — except the three the README embeds
!results/plots/
results/plots/*
!results/plots/gross_vs_net.png
!results/plots/surface_3d_2023-06-14.png
!results/plots/attribution_residuals.png

# Jupyter
.ipynb_checkpoints/

# Agents
.agents/
